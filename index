<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>當沖紀錄快手 - Day Trade Tracker</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- React & ReactDOM CDN -->
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <!-- Babel CDN (用於在瀏覽器解析 JSX) -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800">
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useMemo, useEffect } = React;

        // 模擬 Lucide 圖示組件
        const Icon = ({ name, className }) => {
            useEffect(() => {
                lucide.createIcons();
            }, []);
            return <i data-lucide={name} className={className}></i>;
        };

        function App() {
            const EXCHANGE_RATE_USD_HKD = 7.8;

            const [trades, setTrades] = useState(() => {
                const savedTrades = localStorage.getItem('daytrade_records');
                return savedTrades ? JSON.parse(savedTrades) : [];
            });
            
            useEffect(() => {
                localStorage.setItem('daytrade_records', JSON.stringify(trades));
                if (window.lucide) window.lucide.createIcons();
            }, [trades]);

            const [formData, setFormData] = useState({
                date: new Date().toISOString().split('T')[0],
                symbol: '',
                buyPrice: '',
                sellPrice: '',
                shares: '',
                notes: ''
            });

            const handleInputChange = (e) => {
                const { name, value } = e.target;
                setFormData(prev => ({ ...prev, [name]: value }));
            };

            const previewPnL = useMemo(() => {
                const buy = parseFloat(formData.buyPrice);
                const sell = parseFloat(formData.sellPrice);
                const shares = parseFloat(formData.shares);
                if (!isNaN(buy) && !isNaN(sell) && !isNaN(shares)) {
                    return (sell - buy) * shares;
                }
                return null;
            }, [formData.buyPrice, formData.sellPrice, formData.shares]);

            const handleSubmit = (e) => {
                e.preventDefault();
                const buy = parseFloat(formData.buyPrice);
                const sell = parseFloat(formData.sellPrice);
                const shares = parseFloat(formData.shares);
                
                if (!formData.symbol || isNaN(buy) || isNaN(sell) || isNaN(shares)) return;

                const pnl = (sell - buy) * shares;
                
                const newTrade = {
                    id: Date.now().toString(),
                    date: formData.date,
                    symbol: formData.symbol.toUpperCase(),
                    buyPrice: buy,
                    sellPrice: sell,
                    shares: shares,
                    pnl: pnl,
                    notes: formData.notes
                };

                setTrades(prev => [newTrade, ...prev]);
                setFormData(prev => ({ ...prev, symbol: '', buyPrice: '', sellPrice: '', shares: '', notes: '' }));
                window.scrollTo({ top: 0, behavior: 'smooth' });
            };

            const handleDelete = (id) => {
                if (window.confirm('確定要刪除這筆紀錄嗎？')) {
                    setTrades(prev => prev.filter(trade => trade.id !== id));
                }
            }

            const stats = useMemo(() => {
                const totalTrades = trades.length;
                let totalPnL = 0;
                let winningTrades = 0;
                trades.forEach(trade => {
                    totalPnL += trade.pnl;
                    if (trade.pnl > 0) winningTrades += 1;
                });
                const winRate = totalTrades > 0 ? ((winningTrades / totalTrades) * 100).toFixed(1) : 0;
                return { totalTrades, totalPnL, winRate };
            }, [trades]);

            const exportCSV = () => {
                if (trades.length === 0) return;
                const headers = ["日期", "股票", "買入價(USD)", "賣出價(USD)", "股數", "損益(USD)", "損益(HKD)", "備註"];
                const rows = trades.map(t => [
                    t.date, t.symbol, t.buyPrice, t.sellPrice, t.shares, t.pnl.toFixed(2), (t.pnl * EXCHANGE_RATE_USD_HKD).toFixed(2), t.notes
                ]);
                const csvContent = [headers, ...rows].map(e => e.join(",")).join("\n");
                const blob = new Blob(["\ufeff" + csvContent], { type: 'text/csv;charset=utf-8;' });
                const url = URL.createObjectURL(blob);
                const link = document.createElement("a");
                link.setAttribute("href", url);
                link.setAttribute("download", `trading_records.csv`);
                link.click();
            };

            return (
                <div className="min-h-screen p-4 md:p-8 pb-20">
                    <div className="max-w-6xl mx-auto space-y-6">
                        <header className="flex flex-col md:flex-row md:items-center justify-between gap-4">
                            <div className="flex items-center gap-3">
                                <Icon name="activity" className="w-8 h-8 text-blue-600" />
                                <h1 className="text-xl md:text-3xl font-bold text-slate-900">當沖紀錄快手</h1>
                            </div>
                            <button onClick={exportCSV} className="flex items-center justify-center gap-2 bg-white border border-slate-200 px-4 py-2 rounded-lg text-sm font-medium hover:bg-slate-50 shadow-sm">
                                <Icon name="download" className="w-4 h-4" /> 匯出 CSV
                            </button>
                        </header>

                        <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div className="bg-white rounded-xl shadow-sm p-5 border border-slate-200">
                                <div className="flex items-center gap-3">
                                    <div className={`p-2.5 rounded-full ${stats.totalPnL >= 0 ? 'bg-green-100 text-green-600' : 'bg-red-100 text-red-600'}`}>
                                        <Icon name="dollar-sign" className="w-5 h-5" />
                                    </div>
                                    <div>
                                        <p className="text-xs text-slate-500 font-medium">總損益 (Total P/L)</p>
                                        <p className={`text-xl font-bold ${stats.totalPnL >= 0 ? 'text-green-600' : 'text-red-600'}`}>
                                            {stats.totalPnL >= 0 ? '+' : ''}{stats.totalPnL.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })} <span className="text-sm font-normal">USD</span>
                                        </p>
                                        <p className={`text-xs ${stats.totalPnL >= 0 ? 'text-green-500' : 'text-red-500'}`}>
                                            ≈ {(stats.totalPnL * EXCHANGE_RATE_USD_HKD).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })} HKD
                                        </p>
                                    </div>
                                </div>
                            </div>
                            
                            <div className="bg-white rounded-xl shadow-sm p-5 border border-slate-200">
                                <div className="flex items-center gap-3">
                                    <div className="p-2.5 rounded-full bg-blue-100 text-blue-600">
                                        <Icon name="trending-up" className="w-5 h-5" />
                                    </div>
                                    <div>
                                        <p className="text-xs text-slate-500 font-medium">勝率 (Win Rate)</p>
                                        <p className="text-xl font-bold text-slate-900">{stats.winRate}%</p>
                                    </div>
                                </div>
                            </div>

                            <div className="bg-white rounded-xl shadow-sm p-5 border border-slate-200">
                                <div className="flex items-center gap-3">
                                    <div className="p-2.5 rounded-full bg-purple-100 text-purple-600">
                                        <Icon name="activity" className="w-5 h-5" />
                                    </div>
                                    <div>
                                        <p className="text-xs text-slate-500 font-medium">總交易筆數</p>
                                        <p className="text-xl font-bold text-slate-900">{stats.totalTrades}</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
                            <div className="lg:col-span-1">
                                <div className="bg-white rounded-2xl shadow-md border border-slate-200 p-6">
                                    <h2 className="text-lg font-bold mb-5 flex items-center gap-2 text-slate-800">
                                        <Icon name="plus-circle" className="w-5 h-5 text-blue-600" />
                                        新增紀錄
                                    </h2>
                                    <form onSubmit={handleSubmit} className="space-y-4">
                                        <div className="grid grid-cols-2 gap-3">
                                            <div>
                                                <label className="block text-xs font-bold text-slate-500 uppercase mb-1">日期</label>
                                                <input type="date" name="date" required value={formData.date} onChange={handleInputChange} className="w-full px-3 py-3 bg-slate-50 border border-slate-200 rounded-xl outline-none text-sm" />
                                            </div>
                                            <div>
                                                <label className="block text-xs font-bold text-slate-500 uppercase mb-1">股票代號</label>
                                                <input type="text" name="symbol" required placeholder="代號" value={formData.symbol} onChange={handleInputChange} className="w-full px-3 py-3 bg-slate-50 border border-slate-200 rounded-xl outline-none text-sm uppercase" />
                                            </div>
                                        </div>
                                        <div className="grid grid-cols-2 gap-3">
                                            <div>
                                                <label className="block text-xs font-bold text-slate-500 uppercase mb-1">買入價 (USD)</label>
                                                <input type="number" step="any" inputMode="decimal" name="buyPrice" required value={formData.buyPrice} onChange={handleInputChange} className="w-full px-3 py-3 bg-slate-50 border border-slate-200 rounded-xl outline-none text-sm" />
                                            </div>
                                            <div>
                                                <label className="block text-xs font-bold text-slate-500 uppercase mb-1">賣出價 (USD)</label>
                                                <input type="number" step="any" inputMode="decimal" name="sellPrice" required value={formData.sellPrice} onChange={handleInputChange} className="w-full px-3 py-3 bg-slate-50 border border-slate-200 rounded-xl outline-none text-sm" />
                                            </div>
                                        </div>
                                        <div>
                                            <label className="block text-xs font-bold text-slate-500 uppercase mb-1">股數</label>
                                            <input type="number" inputMode="numeric" name="shares" required value={formData.shares} onChange={handleInputChange} className="w-full px-3 py-3 bg-slate-50 border border-slate-200 rounded-xl outline-none text-sm" />
                                        </div>
                                        <div>
                                            <label className="block text-xs font-bold text-slate-500 uppercase mb-1">備註</label>
                                            <textarea name="notes" rows="2" value={formData.notes} onChange={handleInputChange} className="w-full px-3 py-3 bg-slate-50 border border-slate-200 rounded-xl outline-none text-sm resize-none"></textarea>
                                        </div>
                                        {previewPnL !== null && (
                                            <div className={`p-4 rounded-xl flex justify-between items-center ${previewPnL >= 0 ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700'}`}>
                                                <span className="text-sm font-bold">預估盈虧</span>
                                                <div className="text-right">
                                                    <div className="font-black text-lg">{previewPnL >= 0 ? '+' : ''}{previewPnL.toFixed(2)} USD</div>
                                                    <div className="text-xs font-medium opacity-80">≈ {(previewPnL * EXCHANGE_RATE_USD_HKD).toFixed(2)} HKD</div>
                                                </div>
                                            </div>
                                        )}
                                        <button type="submit" className="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 rounded-xl shadow-lg active:scale-[0.98] flex items-center justify-center gap-2">
                                            <Icon name="save" className="w-5 h-5" /> 儲存交易紀錄
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <div className="lg:col-span-2">
                                <div className="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                                    <div className="p-5 border-b border-slate-100 bg-white font-bold text-slate-800">歷史明細 ({trades.length})</div>
                                    <div className="overflow-x-auto">
                                        <table className="w-full text-left border-collapse">
                                            <thead>
                                                <tr className="bg-slate-50/50 text-[10px] uppercase tracking-wider text-slate-400">
                                                    <th className="px-5 py-4 font-bold">股票/日期</th>
                                                    <th className="px-2 py-4 font-bold text-right">買入/賣出</th>
                                                    <th className="px-5 py-4 font-bold text-right">盈虧 (USD/HKD)</th>
                                                    <th className="px-2 py-4 font-bold text-center">操作</th>
                                                </tr>
                                            </thead>
                                            <tbody className="divide-y divide-slate-50">
                                                {trades.length === 0 ? (
                                                    <tr><td colSpan="4" className="px-5 py-20 text-center opacity-30 font-medium">尚無任何紀錄</td></tr>
                                                ) : (
                                                    trades.map((trade) => (
                                                        <tr key={trade.id} className="hover:bg-slate-50/50 transition-colors">
                                                            <td className="px-5 py-4">
                                                                <div className="font-bold text-slate-900">{trade.symbol}</div>
                                                                <div className="text-[10px] text-slate-400 mt-0.5">{trade.date}</div>
                                                            </td>
                                                            <td className="px-2 py-4 text-right">
                                                                <div className="text-xs text-slate-600 font-medium">B: {trade.buyPrice}</div>
                                                                <div className="text-xs text-slate-600 font-medium">S: {trade.sellPrice}</div>
                                                            </td>
                                                            <td className="px-5 py-4 text-right">
                                                                <div className={`font-bold text-sm ${trade.pnl >= 0 ? 'text-green-600' : 'text-red-600'}`}>
                                                                    {trade.pnl >= 0 ? '+' : ''}{trade.pnl.toFixed(2)}
                                                                </div>
                                                                <div className={`text-[10px] font-medium opacity-70 ${trade.pnl >= 0 ? 'text-green-500' : 'text-red-500'}`}>
                                                                    ≈ {(trade.pnl * EXCHANGE_RATE_USD_HKD).toFixed(2)}
                                                                </div>
                                                            </td>
                                                            <td className="px-2 py-4 text-center">
                                                                <button onClick={() => handleDelete(trade.id)} className="p-2 text-slate-300 hover:text-red-500 rounded-full">
                                                                    <Icon name="trash-2" className="w-4 h-4" />
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    ))
                                                )}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
